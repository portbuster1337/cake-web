{
  "name": "cake-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cake Wallet for the web: a privacy-focused, purely client-side multi-coin wallet whose every network request goes through Tor (Arti in WebAssembly)",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --port 8787",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/unit/**/*.test.ts\"",
    "bridge": "node bridge/index.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@preact/signals": "^2.11.4",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "ethers": "^6.17.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "monero-ts": "^0.11.22",
    "preact": "^10.29.8",
    "tor-js": "^0.4.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "ws": "^8.22.2"
  }
}
